# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development runs PGlite in-process; there is no database server to start.
# `npm run db:setup` creates, migrates, and seeds it under
# %LOCALAPPDATA%\TableFlow\pglite (override with PGLITE_DIR).
DB_DRIVER=pglite

# Production: set DB_DRIVER=pg and use the Supabase Postgres connection string.
# Never commit the real value.
# DB_DRIVER=pg
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres
DATABASE_POOL_MAX=5

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Signs the staff session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-byte-hex-string
SESSION_TTL_HOURS=8

# Auth provider. `local` uses the development-only credentials created by the
# seed script. Supabase Auth wiring is a later stage.
AUTH_PROVIDER=local

# ---------------------------------------------------------------------------
# Supabase (required for production; unused for local development)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development only: shows the demo table link on the landing page.
DEMO_TABLE_TOKEN=devqr-mama-njeris-table-04-9f3a2b1c
